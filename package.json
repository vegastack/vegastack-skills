{
  "name": "vegastack-skills-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/cli build",
    "check": "bun run validate:skill && bun run validate:structure && bun run validate:triggers && bun run test && bun run lint && bun run typecheck",
    "validate:skill": "node packages/cli/scripts/validate-skill.mjs",
    "validate:structure": "node packages/cli/scripts/structure.mjs check",
    "validate:triggers": "node skills/repo-tooling/skillify/scripts/trigger-check.mjs --json",
    "lint": "bun packages/cli/scripts/lint.mjs",
    "typecheck": "bunx tsc -p packages/cli/tsconfig.json --noEmit",
    "test": "bun test",
    "package:cli": "bun run --cwd packages/cli pack:local"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "@types/node": "24.2.0",
    "typescript": "5.9.2"
  }
}
