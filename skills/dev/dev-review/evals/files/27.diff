diff --git a/scripts/check-links.mjs b/scripts/check-links.mjs
index 3f1c2aa..9b7d0e4 100644
--- a/scripts/check-links.mjs
+++ b/scripts/check-links.mjs
@@ -1,9 +1,11 @@
 #!/usr/bin/env node
-// Walks every markdown file under docs/ and reports links whose target does not exist.
-//   node scripts/check-links.mjs [--dir PATH]
+// Walks every markdown file under docs/ and reports links whose target does not exist.
+//   node scripts/check-links.mjs [--dir PATH] [--json]
+// Exit codes: 0 no broken links, 1 broken links found, 2 usage error.
 import { readdirSync, readFileSync, existsSync } from 'node:fs'
 import { join, dirname, resolve } from 'node:path'

 const argv = process.argv.slice(2)
+const json = argv.includes('--json')
 const dirIndex = argv.indexOf('--dir')
 const root = resolve(dirIndex === -1 ? 'docs' : argv[dirIndex + 1])
@@ -21,12 +23,17 @@ function walk(dir) {
   return out
 }

-function brokenLinks(file) {
+function findBroken(file) {
   const body = readFileSync(file, 'utf8')
   const broken = []
   for (const match of body.matchAll(/\]\(([^)]+)\)/g)) {
     const target = match[1]
     if (/^https?:/.test(target)) continue
     if (!existsSync(resolve(dirname(file), target))) broken.push(target)
   }
   return broken
 }

-const report = walk(root).map((file) => ({ file, broken: brokenLinks(file) })).filter((entry) => entry.broken.length)
-for (const entry of report) console.log(`${entry.file}: ${entry.broken.join(', ')}`)
+const report = walk(root).map((file) => ({ file, broken: findBroken(file) })).filter((entry) => entry.broken.length)
+if (json) console.log(JSON.stringify({ broken: report }, null, 2))
+else for (const entry of report) console.log(`${entry.file}: ${entry.broken.join(', ')}`)
 process.exit(report.length ? 1 : 0)
